# 開発用env サンプル
TZ=Asia/Tokyo

# Discord設定
TOKEN=
CLIENT_ID=

# 表示言語: ja（既定）| en。未設定時は各ユーザーの Discord クライアント言語に追従（対応は ja/en のみ）
# 全員固定したいときだけ設定（例: BOT_LOCALE=en）
# BOT_LOCALE=

# SQLite（Sequelize）— 省略時は ./data/boting.sqlite
# SQLITE_PATH=./data/boting.sqlite

# netkeiba race-list cache (default: ./data/cache/netkeibaSchedule.sqlite, 120000ms)
# NETKEIBA_SCHEDULE_CACHE_SQLITE_PATH=./data/cache/netkeibaSchedule.sqlite
# NETKEIBA_SCHEDULE_REFRESH_MS=120000
